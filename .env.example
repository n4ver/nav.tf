# Local development settings. Copy to `.env` at the repository root; docker
# compose (compose.yaml) reads it for variable substitution. The services do not
# load .env themselves: when running them on the host, export these instead.
#
# Runtime environment. APP_ENV=production enables startup guards that refuse
# dev secrets/credentials and hides /docs (re-enable with API_DOCS_ENABLED=true).
# Production config lives in deploy/compose.prod.yml; see deploy/README.md.
# APP_ENV=development
# API_DOCS_ENABLED=true

# CQRS command service
CQRS_COMMAND_DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/cqrs_command
JWT_SECRET=dev-insecure-jwt-secret-change-me
SEED_SERVICE_TOKEN=dev-seed-service-token
FRONTEND_URL=http://localhost:8095
STEAM_OPENID_REALM=http://localhost:8095
STEAM_OPENID_RETURN_TO=http://localhost:8095/api/auth/steam/callback
STEAM_API_KEY=
BOOTSTRAP_ADMIN_STEAM_IDS=
SEED_CACHE_PATH=data/seed_logs_cache.json
# api-consumer (matcha.tf ingest). Docker compose passes WEBHOOK_API_KEY to both
# the api-consumer and the command service, which proxies Admin → Ingest → matcha.tf.
WEBHOOK_API_KEY=dev-insecure-webhook-key-change-me
# API_CONSUMER_URL=http://127.0.0.1:8010  (when running the command service on the host)
# API_CONSUMER_API_KEY=dev-insecure-webhook-key-change-me
# Outbox relay: ordered, exponential backoff, then mark failed
# OUTBOX_MAX_ATTEMPTS=15
# OUTBOX_RETRY_BASE_MS=1000
# OUTBOX_RETRY_MAX_MS=300000
# OUTBOX_POLL_INTERVAL_MS=500

# CQRS query service
CQRS_QUERY_DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/cqrs_query
CQRS_QUERY_QUEUE=cqrs-query
CQRS_EXCHANGE_NAME=tf2-events
# Consumer: in-place retries with backoff, then park on <queue>.parking
# CQRS_CONSUMER_MAX_ATTEMPTS=5
# CQRS_CONSUMER_RETRY_BASE_MS=500
# CQRS_CONSUMER_RETRY_MAX_MS=30000
# Coalesced rating rebuild (deferred by default; inline when CQRS_BROKER_MODE=memory)
# RATING_REBUILD_MODE=deferred
# RATING_REBUILD_DEBOUNCE_MS=2000
# RATING_REBUILD_MAX_DELAY_MS=30000
# RATING_REBUILD_POLL_MS=1000

# Shared broker
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# CQRS_BROKER_MODE=memory

# Seed script (when running server/seed/seed_cqrs.py on the host)
COMMAND_SERVICE_URL=http://127.0.0.1:8001
QUERY_SERVICE_URL=http://127.0.0.1:8002
SEED_ACTOR_STEAM_ID=seed-service
