PORT=8010
LOG_LEVEL=info
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
CQRS_EXCHANGE_NAME=tf2-events
CQRS_DLX_NAME=tf2-events.dlx
CQRS_ROUTING_PREFIX=events
MATCHA_BASE_URL=https://matcha.tf
LOGS_TF_BASE_URL=https://logs.tf/api/v1/log
MATCHA_LEAGUE_ID=1
MATCHA_DIVISION_ID=1
MATCHA_TOURNAMENT_NAME=Matcha.tf Minicup Invite
MATCHA_TOURNAMENT_SLUG=matcha-tf-minicup-invite
POLL_CRON=*/30 * * * *
POLL_ENABLED=false
WEBHOOK_ENABLED=true
HTTP_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=4
HTTP_MIN_DELAY_MS=500
CIRCUIT_ERROR_THRESHOLD=50
CIRCUIT_RESET_MS=30000
ACTOR_ID=api-consumer
WEBHOOK_API_KEY=dev-insecure-webhook-key-change-me
