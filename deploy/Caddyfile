# Production edge for nav.tf: automatic HTTPS, the built SPA, and the API
# gateway. Path mapping mirrors dev/nginx.conf.
#
# Env:
#   DOMAIN      public hostname (e.g. nav.example.com). "localhost" uses Caddy's
#               internal CA, which is handy for local smoke tests.
#   ACME_EMAIL  contact address for Let's Encrypt expiry notices.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 20MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /health {
		reverse_proxy query-service:8002
	}

	# Writes: /api/command/<x> -> command-service /api/v1/commands/<x>
	handle_path /api/command/* {
		rewrite * /api/v1/commands{path}
		reverse_proxy command-service:8001
	}

	# Auth: /api/auth/<x> -> command-service /api/v1/auth/<x>
	# (/api/auth/steam/callback is the public Steam OpenID return URL)
	handle_path /api/auth/* {
		rewrite * /api/v1/auth{path}
		reverse_proxy command-service:8001
	}

	# Legacy direct auth paths.
	handle /api/v1/auth/* {
		reverse_proxy command-service:8001
	}

	# Reads: /api/query/<x> -> query-service /api/v1/queries/<x>
	handle_path /api/query/* {
		rewrite * /api/v1/queries{path}
		reverse_proxy query-service:8002
	}

	# Never fall through to the SPA for unknown API paths.
	handle /api/* {
		respond "Not Found" 404
	}

	# Single-page app with HTML5 history routing.
	handle {
		root * /srv
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path /assets/*
		header @unhashed Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
